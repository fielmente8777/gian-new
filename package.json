{
  "name": "gian-new",
  "version": "0.1.0",
  "private": true,
  "description": "Eazotel core API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=.env --watch-preserve-output --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "env:check": "tsx scripts/check-env-example.ts",
    "docs:export": "tsx scripts/export-openapi.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "billing:seed": "tsx scripts/seed-billing.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mongoose": "^8.19.1",
    "nodemailer": "^7.0.9",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
