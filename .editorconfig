# Basic editor settings for any editor (VS Code reads it with the EditorConfig extension).
# Prettier also reads these, so the two never disagree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
