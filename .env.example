# gian-new environment template.
#   Local:   cp .env.example .env, then fill the REQUIRED values.
#   Docker:  compose reads .env through env_file.
#   AWS:     set these in SSM Parameter Store / Secrets Manager; never ship a .env file.
#
# Sections follow src/config/index.ts. Every variable here is validated at boot
# (src/config/*.config.ts and each module's config/), and `npm run env:check` fails
# if this file and the schemas drift apart. Empty value = not set (default applies).

# ─── app ──────────────────────────────────────────────────────────────────────
# development | test | production (staging also runs as production)
NODE_ENV=development
# development | staging | production
APP_ENV=development
PORT=8000
# public base URL of this API (OAuth callbacks, links in emails)
PUBLIC_URL=http://localhost:8000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# pretty = coloured, one line per request (people); json = one JSON object per line (CloudWatch).
# Empty: pretty when NODE_ENV=development, json otherwise.
LOG_FORMAT=
# Swagger UI at /docs and the spec at /docs/openapi.json. Empty: on everywhere except APP_ENV=production.
API_DOCS_ENABLED=
# comma separated browser origins allowed to call the API ("*" not allowed in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# proxies in front of the app: 0 locally, 1 behind nginx / a load balancer
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
# requests per minute per IP (0 = off)
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=15000

# ─── database ─────────────────────────────────────────────────────────────────
# REQUIRED. Local Docker Mongo from the host machine:
#   mongodb://localhost:27017/?directConnection=true
# Inside docker compose the host is "mongo" instead of "localhost".
# Never point local or staging at the production cluster (README §4).
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# REQUIRED. Database name (production: Courage)
MONGO_DB=Courage
# build indexes on startup (keep false when pointing at a shared cluster)
MONGO_AUTO_INDEX=false
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000

# ─── redis ────────────────────────────────────────────────────────────────────
# REQUIRED. Local: redis://localhost:6379 (inside compose: redis://redis:6379)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=gian

# ─── auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. RS256 private key, PEM base64-encoded on one line. Generate one with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
# Use a different key per environment. Never commit a real one.
AUTH_JWT_PRIVATE_KEY=
# REQUIRED. Key id published in /.well-known/jwks.json; change it when you rotate the key
AUTH_JWT_KEY_ID=dev-1
AUTH_JWT_ISSUER=https://api.eazotel.com
# `aud` of every token. The dashboard (web) and the Android app share the same API and tokens.
AUTH_JWT_AUDIENCE=eazotel-app
# access token lifetime: 30s | 15m | 12h | 7d
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL_DAYS=30
# Refresh token: browsers get it in this httpOnly cookie; the mobile app (header
# X-Client-Platform: android | ios) gets it in the JSON body and sends it back in the body.
AUTH_REFRESH_COOKIE_NAME=ez_rt
# ".eazotel.com" to share the cookie across subdomains; empty = this host only
AUTH_COOKIE_DOMAIN=
# false only for local http://localhost
AUTH_COOKIE_SECURE=true
AUTH_BCRYPT_ROUNDS=12
# Google OAuth client ids whose ID tokens are accepted (comma separated). The web client id
# (= GOOGLE_CLIENT_ID in nexon/gian .env, used by the dashboard button) also covers the
# Android app when the app passes it as serverClientId. Empty = Google sign-in off.
AUTH_GOOGLE_CLIENT_IDS=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
# failed logins per IP + email in 15 minutes before 429
AUTH_LOGIN_MAX_ATTEMPTS=10
# Platform staff (Eazotel + Fielmente team): a Google sign-in with a verified email on these
# domains may list clients and switch into a client account. Password logins never are staff.
AUTH_STAFF_EMAIL_DOMAINS=eazotel.com,fielmente.com
# lifetime of the token a staff member gets inside a client account (no refresh)
AUTH_IMPERSONATION_TTL=1h
# ── old clients (current dashboard + Android app use nexon tokens). Delete when they are updated ──
# nexon's HS256 secret (= JWT_SECRETS in gian/.env, same value nexon has in settings.py).
# Set: old tokens work on every gian-new route, and the old paths (/eazotel/ceateuser,
# /user/googleauth, /eazotel/edit/password, /admin/switch-account) are served. Empty: both off.
AUTH_LEGACY_JWT_SECRET=
# lifetime of nexon-style tokens issued on the old login paths (nexon: 15)
AUTH_LEGACY_TOKEN_TTL_DAYS=15
# also write nexon's SHA-256 password hash when a password is set, so nexon logins keep working.
# Set false the day nexon stops answering logins.
AUTH_LEGACY_PASSWORD_SYNC=true
